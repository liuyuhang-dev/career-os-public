    { "source": "E2", "after": "S5", "kind": "assert", "mode": "state-report", "path": "pendingOps", "op": "eq", "value": [] },
    { "source": "E3", "after": "S5", "kind": "assert", "mode": "state-report", "path": "player.coin", "op": "eq", "value": 500 }
  ],
  "evidence": ["screenshot", "state_report", "logcat"],
