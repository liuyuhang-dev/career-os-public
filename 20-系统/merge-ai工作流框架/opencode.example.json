{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "permission": "allow",
    "mcp": {
        "unity": {
            "type": "local",
            "command": [
                "unity",
                "mcp"
            ],
            "enabled": true
        }
    },
    "provider": {
        "<STUDIO>": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "<STUDIO>",
            "options": {
                "baseURL": "http://<IP>:12354/v1"
            },
            "models": {
                "deepseek-flash": {
                    "name": "deepseek-flash",
                    "attachment": true,
                    "reasoning": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.3,
                        "output": 9,
                        "cache_read": 0.1
                    }
                }
            }
        }
    }
}