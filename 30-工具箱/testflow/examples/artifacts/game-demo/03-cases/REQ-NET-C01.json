  "determinism": { "seed": 20260917, "fixed_timestep_ms": 16, "disable_animations": true },
  "preconditions": [
    { "id": "PRE-1", "action": "launch_host", "host": "wechat" },
    { "id": "PRE-2", "action": "open_entry", "entry": "minigame-recent", "appid": "wxXXXXXXXXXXXXXXXX" }
  ],
  "steps": [
    { "id": "S1", "action": "tap", "target": { "anchor": { "text": "开始游戏", "region": [0.0, 0.78, 1.0, 1.0] } } },
    { "id": "S2", "action": "network", "profile": "weak", "note": "设备侧 tc/netem 限速,通常需 root" },
    { "id": "S3", "action": "wait", "ms": 5000 },
    { "id": "S4", "action": "reset_network" },
    { "id": "S5", "action": "wait_for", "question": "屏幕上是否出现包含「重连成功」字样的提示?", "region": [0.0, 0.3, 1.0, 0.7], "timeout_ms": 30000 },
